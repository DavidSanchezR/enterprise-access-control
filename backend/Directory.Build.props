<Project>

  <!--
    Propiedades compartidas por todos los proyectos de la solución (T005).
    Mantiene el stack alineado con plan.md: .NET 10 LTS, C# 13, nullable habilitado.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      InvariantGlobalization queda deshabilitado a propósito: Microsoft.Data.SqlClient requiere
      soporte de globalización (manejo de colaciones) y falla al conectar con
      "Globalization Invariant Mode is not supported".
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
