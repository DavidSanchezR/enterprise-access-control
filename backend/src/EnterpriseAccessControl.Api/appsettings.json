{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Jwt": {
    "Issuer": "enterprise-access-control",
    "Audience": "enterprise-access-control-spa",
    "SigningKey": "",
    "AccessTokenMinutos": 60
  },
  "PasswordPolicy": {
    "LongitudMinima": 10,
    "RequiereMayuscula": true,
    "RequiereMinuscula": true,
    "RequiereDigito": true,
    "IntentosFallidosParaBloqueo": 5,
    "DiasExpiracion": 90,
    "HistorialNoReutilizable": 5
  },
  "ZonaHoraria": {
    "TimeZoneId": "America/Lima"
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  }
}
