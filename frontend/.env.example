# API a la que el servidor de desarrollo de Vite reenvía /api y /health (mismo origen, sin CORS).
# Por defecto: la API de `dotnet run` (http://localhost:5290). Con docker compose: http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:5290

# Solo si la SPA debe llamar a una API en OTRO origen (requiere configurar CORS en la API).
# Déjela sin definir para usar el mismo origen.
# VITE_API_BASE_URL=

# Pruebas end-to-end (Playwright)
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8080
